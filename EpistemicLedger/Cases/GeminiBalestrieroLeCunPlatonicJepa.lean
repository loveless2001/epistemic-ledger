import EpistemicLedger.AuditRules

/-
Independent audit record (by Gemini) for:
  Randall Balestriero & Yann LeCun,
  "Proving and Improving the Platonic Representation Hypothesis with JEPAs"
  arXiv:2610.39302v1 (29 Oct 2026)

Written directly from the arXiv text without copying other auditors' dependency lists.
-/
namespace EpistemicLedger.Cases.GeminiBalestrieroLeCunPlatonicJepa

/-- Dependencies extracted from Balestriero & LeCun (2026), Sections 1–5 & 7. -/
inductive Dep where
  /-- External positive-pair grouping ("good views") defining which observations belong to one scene. -/
  | curatedPositivePairOracle
  /-- Synthetic recaptions on Recap-DataComp generated by LLaVA (LLaMA-3-8B + CLIP ViT-L/14 vision encoder). -/
  | llavaClipRecaptioner
  /-- Frozen target vision encoders (DINOv2—itself a bad-view crop JEPA—CLIP, MAE, I-JEPA) & benchmarks (WIT-1024, COCO). -/
  | frozenVisionBenchmarkTargets
  /-- Paired image–caption linear map (orthonormal rows, 0.22M–1.9M params) used in retrieval/captioning. -/
  | pairedOrthonormalLinearMap
  /-- Hyperparameter & SIGReg-weight selection tuned only for good-view JEPA (4th seed dropped to .121). -/
  | goodViewHyperparamSelection
  /-- Overlap of ≥43/1024 WIT captions in Recap-DataComp alt-texts (tested: removing changes scores ≤ .002). -/
  | witCorpusOverlap
  /-- Measured alignment/retrieval/captioning scores across experimental runs. -/
  | empiricalAlignmentMeasurements
  deriving DecidableEq, Repr

/-- Hypotheses required to lift Theorem 1 / experiments to real-world Platonic Representation Hypothesis. -/
inductive Hyp where
  /-- World Z is finite and each modality rendering g_m is injective (no lossy ambiguity like "The Dress"). -/
  | finiteWorldInjectiveRenderings
  /-- Modalities share the exact same world positive-pair distribution π with matched marginals. -/
  | sharedPositiveKernelAcrossModalities
  /-- Exact population optima of second-order whitened objective with strict spectral gap μ_k > μ_{k+1}. -/
  | populationOptimaWithSpectralGap
  /-- Uniqueness up to rotation holds under LeJEPA's full-distribution SIGReg Gaussian constraint (left as assumption, p. 3 & 15). -/
  | leJepaSigRegUniqueness
  /-- Inter-observer / cross-modal consensus under shared positives recovers reality z rather than shared pipeline/observer biases. -/
  | consensusImpliesRealityRecovery
  deriving DecidableEq, Repr

def experimentDeps : List (Dependency Dep) :=
  [ ⟨.curatedPositivePairOracle, .setByExperimenter⟩
  , ⟨.llavaClipRecaptioner, .setByExperimenter⟩
  , ⟨.frozenVisionBenchmarkTargets, .setByExperimenter⟩
  , ⟨.pairedOrthonormalLinearMap, .setByExperimenter⟩
  , ⟨.goodViewHyperparamSelection, .setByExperimenter⟩
  , ⟨.witCorpusOverlap, .measured⟩
  , ⟨.empiricalAlignmentMeasurements, .measured⟩
  ]

/--
Claim 1 (Headline claim, Abstract & Sec. 1 p. 3):
"The PRH—with JEPAs—is no longer a hypothesis but a theorem: separately trained
modalities converge to the same representation of the world."
-/
def headlinePrhTheoremClaim : Claim Dep Hyp where
  statement :=
    "The Platonic Representation Hypothesis with JEPAs is no longer a hypothesis but a theorem: separately trained modalities converge to a shared representation of the world."
  kind := .intrinsic
  used := experimentDeps
  declared := [.empiricalAlignmentMeasurements]
  forgets :=
    [ -- Table 7 / Sec. 7 p. 15: removing the LLaVA/CLIP recaptioner drops WIT alignment from .107 to .060.
      ⟨.llavaClipRecaptioner, .contradicted⟩
    , -- Sec. 4.3 p. 11: removing the ≥43 overlapping WIT captions changes all 9 checked models by ≤ .002.
      ⟨.witCorpusOverlap, .shown⟩
    , -- Sec. 2.2 Theorem 2 & Sec. 7: positive-pair definition sets the learned spectral kernel; invariance not shown.
      ⟨.curatedPositivePairOracle, .notShown⟩
    ]
  hypotheses :=
    [ -- Sec. 7 Known limitations: "real modalities are lossy".
      ⟨.finiteWorldInjectiveRenderings, .knownFalse⟩
    , -- Sec. 7 Known limitations: "no experiment meets the hypotheses of Theorem 1 exactly, since ... the image side mostly uses crops".
      ⟨.sharedPositiveKernelAcrossModalities, .knownFalse⟩
    , ⟨.populationOptimaWithSpectralGap, .bet⟩
    , ⟨.leJepaSigRegUniqueness, .bet⟩
    , ⟨.consensusImpliesRealityRecovery, .bet⟩
    ]
  declaredBets := []

/--
Claim 2 (Conditional mathematical theorem, Sec. 2 Theorem 1 + Proposition 1):
Within the idealized mathematical model itself, all hypotheses are part of the target definition.
-/
def conditionalIdealizedTheoremClaim : Claim Dep Hyp where
  statement :=
    "In an idealized finite world with injective renderings, shared positive-pair kernel π, and population optima of a whitened second-order JEPA with spectral gap, every modality learns the top-k spectral embedding of π up to an orthogonal rotation."
  kind := .conditional
  used := [⟨.curatedPositivePairOracle, .setByExperimenter⟩]
  declared := [.curatedPositivePairOracle]
  forgets := []
  hypotheses :=
    [ ⟨.finiteWorldInjectiveRenderings, .discharged⟩
    , ⟨.sharedPositiveKernelAcrossModalities, .discharged⟩
    , ⟨.populationOptimaWithSpectralGap, .discharged⟩
    ]
  declaredBets := []

/--
Claim 3 (Narrow empirical / engineering claim):
Declares the curated grouping, LLaVA/CLIP recaptions, frozen benchmarks, linear map,
and hyperparameter tuning; cleanly forgets `witCorpusOverlap` via shown invariance (≤ .002).
-/
def narrowEngineeringClaim : Claim Dep Hyp where
  statement :=
    "On Recap-DataComp texts grouped by image (with LLaVA/CLIP recaptions) and good-view-tuned hyperparameters, good-view text LeJEPA aligns with frozen DINOv2/CLIP using 42x fewer samples than next-token prediction and exceeds evaluated LLMs up to 72B on WIT/COCO."
  kind := .conditional
  used := experimentDeps
  declared :=
    [ .curatedPositivePairOracle
    , .llavaClipRecaptioner
    , .frozenVisionBenchmarkTargets
    , .pairedOrthonormalLinearMap
    , .goodViewHyperparamSelection
    , .empiricalAlignmentMeasurements
    ]
  forgets := [⟨.witCorpusOverlap, .shown⟩]
  hypotheses := []
  declaredBets := []

theorem headline_rejected : verdict headlinePrhTheoremClaim = .rejected := by
  decide

theorem headline_contradicts_llava_forget :
    Finding.forgetContradicted Dep.llavaClipRecaptioner ∈ audit headlinePrhTheoremClaim := by
  decide

theorem headline_accepts_wit_overlap_forget :
    Finding.droppedDependency Dep.witCorpusOverlap ∉ audit headlinePrhTheoremClaim ∧
    Finding.forgetWithoutEvidence Dep.witCorpusOverlap ∉ audit headlinePrhTheoremClaim ∧
    Finding.forgetContradicted Dep.witCorpusOverlap ∉ audit headlinePrhTheoremClaim := by
  decide

theorem headline_flags_injective_false :
    Finding.hypothesisKnownFalse Hyp.finiteWorldInjectiveRenderings ∈ audit headlinePrhTheoremClaim := by
  decide

theorem headline_flags_shared_kernel_false :
    Finding.hypothesisKnownFalse Hyp.sharedPositiveKernelAcrossModalities ∈ audit headlinePrhTheoremClaim := by
  decide

theorem headline_flags_intrinsic_oracle :
    Finding.intrinsicOnExperimenterStructure Dep.curatedPositivePairOracle ∈ audit headlinePrhTheoremClaim := by
  decide

theorem conditional_theorem_admissible :
    verdict conditionalIdealizedTheoremClaim = .admissible := by
  decide

theorem narrow_engineering_admissible :
    verdict narrowEngineeringClaim = .admissible := by
  decide

end EpistemicLedger.Cases.GeminiBalestrieroLeCunPlatonicJepa
