import EpistemicLedger.AuditRules

/-
Case 2. R. Balestriero and Y. LeCun, "Proving and Improving the Platonic
Representation Hypothesis with JEPAs", arXiv:2610.39302v1.

Record written by claude from the theory section, the conclusion, the "Known
limitations" paragraph and the appendix on caption sources. Quotes are from
the paper.
-/
namespace EpistemicLedger.Cases.BalestrieroLeCunPlatonicJepa

/-- What the paper's experiments use to obtain alignment. -/
inductive Dep where
  /-- Which texts count as views of one scene: "they require knowing which
  texts describe the same scene, the grouping of human captions by image";
  "Paired information thus enters through the definition of positives". -/
  | positivePairGroupingByImage
  /-- "two of each image's three texts are generated by an image captioner
  (LLaVA ..., whose vision encoder is CLIP ViT-L/14) and carry information
  distilled from image–text training". Table 7: .107 with recaptions, .060
  without any image captioner. -/
  | captionsFromLlavaWithClipVision
  /-- Mutual nearest-neighbour alignment scores against image encoders. -/
  | measuredAlignmentScores
  deriving DecidableEq, Repr

/-- Hypotheses of Theorem 1 (the "Platonic Representation Theorem"). -/
inductive Hyp where
  /-- "Let a world be a finite set of states". -/
  | finiteWorld
  /-- "an injective rendering x = g_m(z)". Limitations: "real modalities are lossy". -/
  | injectiveRendering
  /-- "Let M ≥ 2 modalities share one positive-pair distribution". In the
  experiments this holds because the dataset builder groups texts by image. -/
  | sharedPositivePairDistribution
  /-- "let the minimizers of L_π be unique up to rotation"; for LeJEPA's
  constraint, "which we leave as an assumption". -/
  | minimizersUniqueUpToRotation
  /-- "Our theorems are population statements"; "finite-sample training relies
  on the network's inductive bias". -/
  | populationOptimum
  deriving DecidableEq, Repr

def usedByExperiments : List (Dependency Dep) :=
  [ ⟨.positivePairGroupingByImage, .setByExperimenter⟩,
    ⟨.captionsFromLlavaWithClipVision, .setByExperimenter⟩,
    ⟨.measuredAlignmentScores, .measured⟩ ]

/-- Theorem 1 applied to real models and real data. Statuses follow the
paper's own limitations paragraph ("no experiment meets the hypotheses of
Theorem 1 exactly"). -/
def theoremOneAppliedToRealData : List (Hypothesis Hyp) :=
  [ ⟨.finiteWorld, .bet⟩,
    ⟨.injectiveRendering, .knownFalse⟩,
    ⟨.sharedPositivePairDistribution, .bet⟩,
    ⟨.minimizersUniqueUpToRotation, .bet⟩,
    ⟨.populationOptimum, .bet⟩ ]

/-- The introduction's framing: the hypothesis about models converging to one
representation of the world is now a theorem. -/
def headlineClaim : Claim Dep Hyp where
  statement :=
    "The PRH (separately trained models converge to the same representation of the world) is no longer a hypothesis but a theorem."
  kind := .intrinsic
  used := usedByExperiments
  declared := []
  forgets := []
  hypotheses := theoremOneAppliedToRealData
  declaredBets := []

/-- Theorem 1 as a conditional statement, applied to nothing. -/
def conditionalTheoremClaim : Claim Dep Hyp where
  statement :=
    "IF a finite world is rendered injectively, modalities share one positive-pair distribution and minimizers are unique up to rotation, THEN population optima agree up to one rotation."
  kind := .conditional
  used := []
  declared := []
  forgets := []
  hypotheses := []
  declaredBets := []

/-- The engineering claim, with every dependency carried. -/
def engineeringClaim : Claim Dep Hyp where
  statement :=
    "Given positives grouped by image and texts that include LLaVA recaptions, a text JEPA reaches the alignment of next-token prediction on the same corpus with far fewer samples."
  kind := .conditional
  used := usedByExperiments
  declared :=
    [ .positivePairGroupingByImage, .captionsFromLlavaWithClipVision,
      .measuredAlignmentScores ]
  forgets := []
  hypotheses := []
  declaredBets := []

/-- The headline is rejected, and these are exactly the findings. -/
theorem headline_findings :
    audit headlineClaim =
      [ .droppedDependency .positivePairGroupingByImage,
        .droppedDependency .captionsFromLlavaWithClipVision,
        .droppedDependency .measuredAlignmentScores,
        .undeclaredBet .finiteWorld,
        .hypothesisKnownFalse .injectiveRendering,
        .undeclaredBet .sharedPositivePairDistribution,
        .undeclaredBet .minimizersUniqueUpToRotation,
        .undeclaredBet .populationOptimum,
        .intrinsicOnExperimenterStructure .positivePairGroupingByImage,
        .intrinsicOnExperimenterStructure .captionsFromLlavaWithClipVision ] := by
  decide

theorem headline_rejected : verdict headlineClaim = .rejected := by decide

/-- Controls: the same audit accepts the two narrow claims. -/
theorem conditional_theorem_admissible :
    verdict conditionalTheoremClaim = .admissible := by decide

theorem engineering_claim_admissible :
    verdict engineeringClaim = .admissible := by decide

end EpistemicLedger.Cases.BalestrieroLeCunPlatonicJepa
