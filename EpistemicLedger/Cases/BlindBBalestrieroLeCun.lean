import EpistemicLedger.AuditRules

/-
Claim records for "Proving and Improving the Platonic Representation
Hypothesis with JEPAs" (paper/paper.txt). Records what each claim's own
derivation or experiment leaned on; does not judge truth.
-/
namespace EpistemicLedger.Cases.BlindB.BalestrieroLeCun

inductive Dep where
  -- Theory setting (claim 2; Theorem 1 and its proof, Sec. 2.1, App. A.2)
  /-- "Let a world be a finite set of states z ∈ Z with probabilities p(z) > 0" (Sec. 2.1). -/
  | finiteWorld
  /-- "modality m through an injective rendering x = gm(z)" (Sec. 2.1); used by Lemma 1. -/
  | injectiveRendering
  /-- Objective (1): prediction term ℓ plus anti-collapse Ω "that depends on f only through
  the distribution of its embeddings"; "the predictor is the identity" (Sec. 2.1). -/
  | objectiveFormEq1
  /-- Theorem 1 speaks of "every minimizer f m⋆ of Lm", the population objective;
  "Our theorems are population statements" (Sec. 7). -/
  | populationMinimizers
  /-- "Let M ≥ 2 modalities share one positive-pair distribution, π1 = · · · = πM = π" (Thm. 1). -/
  | sharedPositivePairs
  /-- "let the minimizers of Lπ be unique up to rotation" (Thm. 1); "The key assumption is
  uniqueness up to rotation" (Sec. 2.1). -/
  | uniqueUpToRotation
  /-- "Let M ≥ 2 modalities" (Thm. 1). -/
  | atLeastTwoModalities
  /-- One shared embedding dimension k: "h⋆ : Z → Rk", "Qm ∈ O(k)" (Thm. 1). -/
  | commonEmbeddingDimK
  -- Experiments and tools (claims 1 and 3)
  /-- "image and text encoders are trained separately, each with the same LeJEPA objective [4]"
  (Sec. 3, Setup). -/
  | jepaObjective
  /-- Good views: "views drawn from different observations of the same world state, each trimmed
  ... and lightly masked" (Sec. 3.2); "Trimming is the knob that matters" (Fig. 7). -/
  | goodViewPositives
  /-- "they require knowing which texts describe the same scene, the grouping of human captions
  by image on Flickr and COCO, while on Recap-DataComp two of each image's three texts are
  generated by an image captioner" (Sec. 7). -/
  | sceneGroupingOfTexts
  /-- "our image encoders, and DINOv2, are bad-view JEPAs: their positives are crops of one
  photograph. Our experiments mostly vary the text side against a frozen DINOv2" (Sec. 2.3). -/
  | frozenDinov2Reference
  /-- "One linear map with orthonormal rows, the only part fitted on pairs" (Contribution 5);
  "0.22M for DINOv2 ViT-B and 1.9M ... all fitted on pairs" (Sec. 2.2). -/
  | pairFittedRotation
  /-- Pair-free alignment uses "their method, code, hyperparameters and five seeds unchanged"
  of Schnaus et al. [54] (Sec. 5.2). -/
  | schnausPairFreeMethod
  /-- SIGReg weight: "plus SIGReg with λ = 0.02" (Sec. 3); "that weight was selected on WIT"
  (App. C, 940M runs). -/
  | sigregWeight
  /-- Alignment scores, retrieval, CIDEr, zero-shot accuracies read off trained encoders
  (Tables 1-4, Figs. 5-11). -/
  | measuredAlignmentScores
  -- Claim 3 specifics (Sec. 4.2, Fig. 1, App. C Table 14)
  /-- Next-token prediction "with the same 109M encoder and texts from the same corpus" (Sec. 4.2). -/
  | nextTokenBaseline
  /-- Recap-DataComp: "each image's alt-text and two recaptions, written by an image captioner
  (LLaVA built on LLaMA-3-8B), are its views" (Sec. 4.1). -/
  | recapDataCompCorpus
  /-- "That is 42 times fewer samples, 14 times fewer text tokens since a good-view sample reads
  three texts" (Sec. 4.2): the counting unit. -/
  | sampleCountUnit
  /-- "the good-view JEPA reaches .109 on WIT" ... "the PRH paper's benchmark (WIT-1024,
  mutual 10-NN)" (Sec. 4.2, Fig. 1). -/
  | witMutualKnnBenchmark
  /-- "With the same 109M encoder" (Sec. 4.2); "At matched samples the gap is larger still:
  .108 against .071 at 21.6M samples for the 33M encoder". -/
  | encoderSize109M
  /-- "each run uses the recipe of its scale (learning rate 10−4 and batch 256 against 2 · 10−4
  and 2,048)" (Sec. 4.2). -/
  | perScaleRecipe
  /-- "after 21.6M training samples (the texts of 2.16M images)" vs "after 900M samples (.111,
  the texts of 940M images; we scored no earlier next-token checkpoint)" (Sec. 4.2). -/
  | comparisonCheckpoints
  /-- "and 435 times fewer unique images" (Sec. 4.2); "These runs change unique texts, samples
  seen and batch size together, and we do not separate their effects" (App. C). -/
  | uniqueImagesSubset
  deriving DecidableEq, Repr

inductive Hyp where
  /-- Lemma 1: "If gm is injective, f ↦ f ◦ gm is a bijection ..." (App. A.2). -/
  | lemma1Injective
  /-- Thm. 1: "share one positive-pair distribution". For real modalities: "Alas, in practice
  the modalities' positives are not the same pairs of world states" (Sec. 2.2); "the image side
  mostly uses crops as positives" (Sec. 7). -/
  | thm1SharedPositives
  /-- Thm. 1: "minimizers of Lπ be unique up to rotation". For LeJEPA, used in all runs:
  "Proposition 1 does not cover uniqueness under its full-distribution constraint, which we
  leave as an assumption" (Sec. 2.1). -/
  | thm1UniqueUpToRotation
  /-- Setting: "one finite world rendered injectively" (Sec. 2.1). For real data: "real
  modalities are lossy" (Sec. 7); "a caption sees only part of a photograph" (Sec. 2.3). -/
  | thm1FiniteInjectiveWorld
  /-- Setting: "population optima" (Sec. 2.1). Real runs: "finite-sample training relies on the
  network's inductive bias" (Sec. 7); not checked to be population minimizers. -/
  | thm1PopulationOptima
  /-- Setting: one common k. Real tool: "When the two embedding dimensions differ (768 for
  DINOv2, 384 for our text JEPA) we fit a linear map with orthonormal rows, a case the theory
  does not cover" (Sec. 2.2). -/
  | thm1EqualEmbeddingDims
  /-- Objective of form (1): "LeJEPA's SIGReg, which pushes the embeddings toward an isotropic
  Gaussian, in expectation over its directions [4] (Section A)" (Sec. 2.1). -/
  | thm1ObjectiveForm
  deriving DecidableEq, Repr

open Dep Hyp

/-- Claim 1: end of Introduction (Sec. 1). Target: JEPAs trained on real modalities. -/
def claim1 : Claim Dep Hyp where
  statement := "This demonstrates that the PRH–with JEPAs–is no longer a hypothesis but a theorem and a tool."
  kind := .intrinsic
  used :=
    [ ⟨jepaObjective, .setByExperimenter⟩,
      ⟨goodViewPositives, .setByExperimenter⟩,
      ⟨sceneGroupingOfTexts, .setByExperimenter⟩,
      ⟨frozenDinov2Reference, .setByExperimenter⟩,
      ⟨pairFittedRotation, .measured⟩,
      ⟨schnausPairFreeMethod, .setByExperimenter⟩,
      ⟨sigregWeight, .setByExperimenter⟩,
      ⟨measuredAlignmentScores, .measured⟩ ]
  declared := [jepaObjective]
  forgets := []
  hypotheses :=
    [ ⟨thm1SharedPositives, .knownFalse⟩,
      ⟨thm1UniqueUpToRotation, .bet⟩,
      ⟨thm1FiniteInjectiveWorld, .knownFalse⟩,
      ⟨thm1PopulationOptima, .bet⟩,
      ⟨thm1EqualEmbeddingDims, .knownFalse⟩,
      ⟨thm1ObjectiveForm, .discharged⟩ ]
  declaredBets := []

/-- Claim 2: Theorem 1 as stated (Sec. 2.1), proof in App. A.2. Its notation (Z, gm, Lm, Lπ,
k) carries the setting defined just before it in Sec. 2.1, so that setting is read as declared. -/
def claim2 : Claim Dep Hyp where
  statement := "Let M ≥ 2 modalities share one positive-pair distribution, π1 = ... = πM = π, and let the minimizers of Lπ be unique up to rotation. Then there is one embedding of the world h⋆ : Z → R^k such that every minimizer f_m⋆ of L_m, for every modality m, satisfies f_m⋆ ∘ g_m = Q_m h⋆ for some Q_m ∈ O(k), so any two modalities agree up to the single rotation."
  kind := .conditional
  used :=
    [ ⟨finiteWorld, .setByExperimenter⟩,
      ⟨injectiveRendering, .setByExperimenter⟩,
      ⟨objectiveFormEq1, .setByExperimenter⟩,
      ⟨populationMinimizers, .setByExperimenter⟩,
      ⟨sharedPositivePairs, .setByExperimenter⟩,
      ⟨uniqueUpToRotation, .setByExperimenter⟩,
      ⟨atLeastTwoModalities, .setByExperimenter⟩,
      ⟨commonEmbeddingDimK, .setByExperimenter⟩ ]
  declared :=
    [ finiteWorld, injectiveRendering, objectiveFormEq1, populationMinimizers,
      sharedPositivePairs, uniqueUpToRotation, atLeastTwoModalities, commonEmbeddingDimK ]
  forgets := []
  hypotheses := [ ⟨lemma1Injective, .discharged⟩ ]
  declaredBets := []

/-- Claim 3: abstract, Sec. 4.2, Fig. 1, Sec. 7. -/
def claim3 : Claim Dep Hyp where
  statement := "Good views need 42 times fewer training samples than next-token prediction on the same corpus to reach the same alignment"
  kind := .conditional
  used :=
    [ ⟨goodViewPositives, .setByExperimenter⟩,
      ⟨nextTokenBaseline, .setByExperimenter⟩,
      ⟨recapDataCompCorpus, .setByExperimenter⟩,
      ⟨sampleCountUnit, .setByExperimenter⟩,
      ⟨measuredAlignmentScores, .measured⟩,
      ⟨witMutualKnnBenchmark, .setByExperimenter⟩,
      ⟨frozenDinov2Reference, .setByExperimenter⟩,
      ⟨encoderSize109M, .setByExperimenter⟩,
      ⟨perScaleRecipe, .setByExperimenter⟩,
      ⟨comparisonCheckpoints, .setByExperimenter⟩,
      ⟨uniqueImagesSubset, .setByExperimenter⟩ ]
  declared :=
    [ goodViewPositives, nextTokenBaseline, recapDataCompCorpus, sampleCountUnit,
      measuredAlignmentScores ]
  forgets := []
  hypotheses := []
  declaredBets := []

#eval audit claim1
#eval verdict claim1
#eval audit claim2
#eval verdict claim2
#eval audit claim3
#eval verdict claim3

theorem claim1_verdict : verdict claim1 = .rejected := by decide
theorem claim2_verdict : verdict claim2 = .admissible := by decide
theorem claim3_verdict : verdict claim3 = .rejected := by decide

end EpistemicLedger.Cases.BlindB.BalestrieroLeCun
